// Copy this file to secrets.h (in this same folder) and fill in your
// real WiFi credentials. secrets.h is gitignored, so it never gets
// committed - your WiFi password stays off GitHub even though this
// repo is public.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
#define NET_HOSTNAME  "onair"
