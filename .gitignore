# Swift Package Manager build artifacts
.build/
.swiftpm/

# build-app.sh output (CameraProbe.app / .dmg) - rebuilt locally, not tracked
dist/

# macOS
.DS_Store

# In case a local config ever ends up in the project directory by
# accident - the real one lives at
# ~/Library/Application Support/CameraProbe/config.json, outside the repo.
config.json

*.log

# Real WiFi credentials for the ESP8266 relay firmware - see
# firmware/CameraProbeRelay/secrets.h.example for the tracked template.
firmware/CameraProbeRelay/secrets.h
firmware/CameraProbeRelay8266/secrets.h
**/secrets.h

# Arduino IDE "Export Compiled Binary" output - .bin files go on the
# GitHub release page, not in the repo.
firmware/**/build/

# KiCad local/backup files
*-backups/
*.kicad_prl
fp-info-cache
*.lck
_autosave-*
.history/
*.rpt

# .NET build output (Windows port)
windows/**/bin/
windows/**/obj/
windows/publish/
windows/dist/

# Python bytecode
__pycache__/
